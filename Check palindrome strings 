#include <iostream>
#include <string>
using namespace std;

int main() {
    string word;
    bool palindrome = true;

    cout << "Enter a word: ";
    cin >> word;

    int start = 0;
    int end = word.length() - 1;

    while (start < end) {
        if (word[start] != word[end]) {
            palindrome = false;
            break;
        }

        start++;
        end--;
    }

    if (palindrome) {
        cout << word << " is a palindrome." << endl;
    } else {
        cout << word << " is not a palindrome." << endl;
    }

    return 0;
}