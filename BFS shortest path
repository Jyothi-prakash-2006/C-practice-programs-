#include <iostream>
#include <vector>
#include <deque>
using namespace std;

int main() {
    int n, e;
    cin >> n >> e;

    vector<vector<pair<int, int>>> graph(n);

    for (int i = 0; i < e; i++) {
        int u, v, w;
        cin >> u >> v >> w;

        graph[u].push_back({v, w});
        graph[v].push_back({u, w});
    }

    int source;
    cin >> source;

    vector<int> dist(n, 1e9);
    deque<int> dq;

    dist[source] = 0;
    dq.push_front(source);

    while (!dq.empty()) {
        int u = dq.front();
        dq.pop_front();

        for (auto [v, w] : graph[u]) {
            if (dist[u] + w < dist[v]) {
                dist[v] = dist[u] + w;

                if (w == 0)
                    dq.push_front(v);
                else
                    dq.push_back(v);
            }
        }
    }

    for (int i = 0; i < n; i++)
        cout << i << " -> " << dist[i] << endl;

    return 0;
}
