#include <iostream>
#include <vector>
#include <string>
using namespace std;

class BloomFilter {
    vector<bool> bits;
    int size;

    int hash1(const string& s) {
        unsigned long long h = 0;
        for (char c : s)
            h = (h * 31 + c) % size;
        return h;
    }

    int hash2(const string& s) {
        unsigned long long h = 5381;
        for (char c : s)
            h = (h * 33 + c) % size;
        return h;
    }

    int hash3(const string& s) {
        unsigned long long h = 0;
        for (char c : s)
            h = (h * 37 + c) % size;
        return h;
    }

public:
    BloomFilter(int n) {
        size = n;
        bits.resize(size, false);
    }

    void insert(const string& value) {
        bits[hash1(value)] = true;
        bits[hash2(value)] = true;
        bits[hash3(value)] = true;
    }

    bool possiblyContains(const string& value) {
        return bits[hash1(value)] &&
               bits[hash2(value)] &&
               bits[hash3(value)];
    }
};

int main() {
    int size, n;
    cin >> size >> n;

    BloomFilter filter(size);

    for (int i = 0; i < n; i++) {
        string value;
        cin >> value;
        filter.insert(value);
    }

    int q;
    cin >> q;

    while (q--) {
        string value;
        cin >> value;

        if (filter.possiblyContains(value))
            cout << value << ": Possibly Present\n";
        else
            cout << value << ": Definitely Not Present\n";
    }

    return 0;
}
