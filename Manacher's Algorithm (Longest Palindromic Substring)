#include <iostream>
#include <vector>
#include <string>
#include <algorithm>
using namespace std;

int main() {
    string s;
    getline(cin, s);

    int n = s.size();

    if (n == 0) {
        cout << "Empty String";
        return 0;
    }

    vector<int> odd(n), even(n);

    int left = 0, right = -1;
    int start = 0, maxLength = 1;

    for (int i = 0; i < n; i++) {
        int k = (i > right) ? 1 : min(odd[left + right - i], right - i + 1);

        while (i - k >= 0 && i + k < n &&
               s[i - k] == s[i + k])
            k++;

        odd[i] = k;

        int len = 2 * k - 1;

        if (len > maxLength) {
            maxLength = len;
            start = i - k + 1;
        }

        if (i + k - 1 > right) {
            left = i - k + 1;
            right = i + k - 1;
        }
    }

    left = 0;
    right = -1;

    for (int i = 0; i < n; i++) {
        int k = (i > right) ? 0 : min(even[left + right - i + 1], right - i + 1);

        while (i - k - 1 >= 0 && i + k < n &&
               s[i - k - 1] == s[i + k])
            k++;

        even[i] = k;

        int len = 2 * k;

        if (len > maxLength) {
            maxLength = len;
            start = i - k;
        }

        if (i + k - 1 > right) {
            left = i - k;
            right = i + k - 1;
        }
    }

    cout << "Longest Palindromic Substring: "
         << s.substr(start, maxLength) << endl;

    cout << "Length: " << maxLength << endl;

    return 0;
}
