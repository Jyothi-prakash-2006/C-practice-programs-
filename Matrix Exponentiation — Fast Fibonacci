#include <iostream>
using namespace std;

struct Matrix {
    long long a, b, c, d;
};

Matrix multiply(Matrix x, Matrix y) {
    return {
        x.a * y.a + x.b * y.c,
        x.a * y.b + x.b * y.d,
        x.c * y.a + x.d * y.c,
        x.c * y.b + x.d * y.d
    };
}

Matrix power(Matrix base, long long n) {
    Matrix result = {1, 0, 0, 1};

    while (n > 0) {
        if (n & 1)
            result = multiply(result, base);

        base = multiply(base, base);
        n /= 2;
    }

    return result;
}

long long fibonacci(long long n) {
    if (n == 0)
        return 0;

    Matrix result = power({1, 1, 1, 0}, n - 1);
    return result.a;
}

int main() {
    long long n;
    cin >> n;

    cout << "Fibonacci: " << fibonacci(n) << endl;

    return 0;
}
