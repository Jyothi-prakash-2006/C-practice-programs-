         << ds.connected(0, 2) << endl;

    cout << "0 and 4 connected: "
         << ds.connected(0, 4) << endl;

    ds.unite(2, 4);

    cout << "0 and 4 connected after union: "
         << ds.connected(0, 4) << endl;

    return 0;
}
